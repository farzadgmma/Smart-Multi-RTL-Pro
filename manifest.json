{
  "manifest_version": 3,
  "name": "Smart Multi-RTL Pro | مبتکران نیک افزار",
  "version": "1.0.0",
  "description": "افزونه هوشمند راست‌چین‌سازی خودکار و پیشرفته متون فارسی و عربی - توسعه داده شده توسط کمپانی مبتکران نیک افزار",
  "permissions": [
    "storage",
    "activeTab",
    "contextMenus",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_start"
    }
  ],
  "commands": {
    "toggle-rtl": {
      "suggested_key": {
        "default": "Alt+Shift+X"
      },
      "description": "تغییر جهت (RTL/LTR) المان تحت فوکوس یا متن انتخابی"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
